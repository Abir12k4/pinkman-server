const express = require('express');
const cors = require('cors');
const multer = require('multer');
const jwt = require('jsonwebtoken');
const bcrypt = require('bcryptjs');

const app = express();
app.use(cors());
app.use(express.json({ limit: '50mb' }));

const SECRET = 'mysecretkey123';
const users = [];
const posts = [];
const videos = [];

const upload = multer({ dest: 'uploads/' });
app.use('/uploads', express.static('uploads'));

// -------- AUTH --------
app.post('/signup', async (req, res) => {
  const { name, email, password } = req.body;
  if (users.find(u => u.email === email)) {
    return res.status(400).json({ message: 'Email already exists' });
  }
  const hashed = await bcrypt.hash(password, 10);
  const user = { id: Date.now(), name, email, password: hashed };
  users.push(user);
  const token = jwt.sign({ id: user.id, name, email }, SECRET);
  res.json({ message: 'Account created', token, name });
});

app.post('/login', async (req, res) => {
  const { email, password } = req.body;
  const user = users.find(u => u.email === email);
  if (!user || !(await bcrypt.compare(password, user.password))) {
    return res.status(401).json({ message: 'Invalid email or password' });
  }
  const token = jwt.sign({ id: user.id, name: user.name, email }, SECRET);
  res.json({ message: 'Login successful', token, name: user.name });
});

function auth(req, res, next) {
  const token = req.headers.authorization?.split(' ')[1];
  if (!token) return res.status(401).json({ message: 'No token' });
  try {
    req.user = jwt.verify(token, SECRET);
    next();
  } catch {
    res.status(401).json({ message: 'Invalid token' });
  }
}

// -------- POSTS --------
app.get('/posts', auth, (req, res) => {
  res.json({ posts });
});

app.post('/posts', auth, (req, res) => {
  const { text, image } = req.body;
  const post = {
    id: Date.now(),
    author: req.user.name,
    text: text || '',
    image: image || '',
    time: Date.now(),
    likes: 0,
    liked: false,
    comments: []
  };
  posts.unshift(post);
  res.json({ message: 'Post created' });
});

// -------- VIDEOS --------
app.get('/videos', auth, (req, res) => {
  res.json({ videos });
});

app.post('/videos', auth, upload.single('video'), (req, res) => {
  const caption = req.query.caption || '';
  const videoUrl = req.file ? `/uploads/${req.file.filename}` : '';

  const video = {
    id: Date.now(),
    author: req.user.name,
    caption,
    url: videoUrl,
    time: Date.now(),
    likes: 0,
    liked: false,
    reposts: 0,
    reposted: false,
    repostedBy: '',
    comments: []
  };
  videos.unshift(video);
  res.json({ message: 'Video uploaded' });
});

const PORT = process.env.PORT || 3000;
app.listen(PORT, () => {
  console.log(`Server running on port ${PORT}`);
});
